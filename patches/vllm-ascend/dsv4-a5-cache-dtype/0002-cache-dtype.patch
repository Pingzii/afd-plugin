+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM Ascend project
+
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from vllm_ascend.device.hardware_profile import HardwareCapability
+from vllm_ascend.platform import _configure_deepseek_v4_a5_cache_dtype
+
+
+def _vllm_config(*, architectures, cache_dtype):
+    return SimpleNamespace(
+        model_config=SimpleNamespace(
+            hf_config=SimpleNamespace(architectures=list(architectures)),
+        ),
+        cache_config=SimpleNamespace(cache_dtype=cache_dtype),
+    )
+
+
+def _hardware_profile(*, supports_compressed_cache):
+    return SimpleNamespace(
+        supports=lambda capability: (
+            supports_compressed_cache and capability == HardwareCapability.DSV4_COMPRESSED_CACHE
+        ),
+    )
+
+
+class TestConfigureDeepseekV4A5CacheDtype:
+    @pytest.mark.parametrize(
+        ("architectures", "cache_dtype", "supports_compressed_cache", "expected"),
+        [
+            # A5 DeepSeek V4 left at the default resolves to the only built path.
+            (("DeepseekV4ForCausalLM",), "auto", True, "fp8"),
+            (("DeepseekV41ForCausalLM",), "auto", True, "fp8"),
+            # Explicit user values are preserved, even unsupported ones.
+            (("DeepseekV4ForCausalLM",), "bf16", True, "bf16"),
+            (("DeepseekV4ForCausalLM",), "fp8_e5m2", True, "fp8_e5m2"),
+            (("DeepseekV4ForCausalLM",), "int8", True, "int8"),
+            # Without the compressed-cache capability the platform default stands.
+            (("DeepseekV4ForCausalLM",), "auto", False, "auto"),
+            # Other models keep their configured dtype.
+            (("Qwen3MoeForCausalLM",), "auto", True, "auto"),
+            ((), "auto", True, "auto"),
+        ],
+    )
+    def test_resolves_auto_only_for_deepseek_v4_on_a5(
+        self,
+        architectures,
+        cache_dtype,
+        supports_compressed_cache,
+        expected,
+    ):
+        vllm_config = _vllm_config(architectures=architectures, cache_dtype=cache_dtype)
+
+        with patch(
+            "vllm_ascend.platform.get_current_hardware_profile",
+            return_value=_hardware_profile(supports_compressed_cache=supports_compressed_cache),
+        ):
+            _configure_deepseek_v4_a5_cache_dtype(vllm_config)
+
+        assert vllm_config.cache_config.cache_dtype == expected
