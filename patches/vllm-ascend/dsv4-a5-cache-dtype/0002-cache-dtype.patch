+def _is_deepseek_v4_checkpoint(hf_config: Any) -> bool:
+    """Whether ``hf_config`` describes a DeepSeek V4 family checkpoint.
+
+    The registry spells the family several ways -- ``DeepseekV4ForCausalLM``,
+    the V4.1 ``DeepseekV41ForCausalLM``, its VL spelling
+    ``DeepseekV41ForConditionalGeneration`` and the DSpark draft
+    ``DeepseekV41DSparkModel``. Enumerating those names means a checkpoint whose
+    spelling is missing silently keeps the bf16 default this hardware cannot
+    run, so match the family instead. ``SpeculativeConfig`` can overwrite the
+    instance ``model_type`` for a draft, which is why the declared
+    architectures are checked as well.
+    """
+    model_type = (getattr(hf_config, "model_type", "") or "").lower()
+    if model_type.startswith(_DEEPSEEK_V4_MODEL_TYPE_PREFIX):
+        return True
+    architectures = getattr(hf_config, "architectures", None) or ()
+    return any(architecture.lower().startswith(_DEEPSEEK_V4_ARCHITECTURE_PREFIX) for architecture in architectures)
+
+
+def _configure_deepseek_v4_a5_cache_dtype(vllm_config: VllmConfig) -> None:
+    """Pin the DeepSeek V4 KV cache dtype to the platform's only implementation.
+
+    The A5 DeepSeek V4 sparse-attention path ships a single KV cache
+    implementation: ``kv_compress_epilog``, whose binding accepts only E5M2 or
+    E4M3, while the bf16 alternative needs ``sparse_flash_mla``, which the
+    ascend950 operator set does not build. ``cache_dtype`` nevertheless defaults
+    to ``"auto"``, which vLLM resolves to the model dtype (bf16) -- an answer
+    this hardware rejects -- and that value is read by the sparse-attention plan
+    selection, by ``ascend_config`` and by every KV cache spec. Resolve it once
+    here, before any of them run. Explicit user values are left untouched so an
+    unsupported request keeps failing on its own error rather than being
+    silently rewritten.
+    """
+    model_config = vllm_config.model_config
+    cache_config = vllm_config.cache_config
+    if (
+        model_config is None
+        or cache_config is None
+        or cache_config.cache_dtype != "auto"
+        or not get_current_hardware_profile().supports(HardwareCapability.DSV4_COMPRESSED_CACHE)
+    ):
+        return
+
+    # ModelConfig.architecture is populated later in vLLM initialization. Read
+    # the source-of-truth HF config here because this hook runs early.
+    hf_config = getattr(model_config, "hf_config", None)
+    if hf_config is None or not _is_deepseek_v4_checkpoint(hf_config):
+        return
+
+    cache_config.cache_dtype = "fp8"
+    logger.info_once(
+        "Using fp8 KV cache for DeepSeek V4 on Ascend A5; the bf16 KV cache path is not built for ascend950."
+    )
+
+
